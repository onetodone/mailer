# Settings for `pnpm preview` and `pnpm send:test`. Copy to `.env` and uncomment what you need.

# Locales to render or send, comma-separated. Default: every built-in locale.
# LOCALES=en,be

# Samples for `pnpm send:test` to send, comma-separated. Default: every sample.
# SAMPLES=verify-email,media

# Logo in the email header. Without it, `pnpm preview` shows the OneToDone logo
# from scripts/assets and `pnpm send:test` shows the company name.
# A transparent PNG shows how the logo reads in dark mode.
# LOGO_URL=https://example.com/logo.png
# LOGO_WIDTH=120
# LOGO_HEIGHT=32

# Image from an https: URL in the `media` sample. The default is a placeholder
# service; any public PNG or JPEG around 1068x400 works.
# IMAGE_URL=https://placehold.co/1068x400/png?text=Inline%20Image

# SMTP server for `pnpm send:test`. The defaults match a local Mailpit.
# SMTP_SECURE is `true` (TLS from the start) or `false` (plain text, upgraded
# with STARTTLS when the server offers it). Unset, it is `true` on port 465 only.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Resend API key for `pnpm send:test`. When set, emails go through Resend instead
# of SMTP, and MAIL_FROM is required. Until a domain is verified in Resend, send
# from `onboarding@resend.dev` to the address of your Resend account only.
# RESEND_API_KEY=

# Postmark server API token for `pnpm send:test` (Servers → your server → API
# Tokens). Until the account is approved, Postmark only delivers to addresses on
# the domain of a confirmed sender signature. The token `POSTMARK_API_TEST`
# accepts requests without sending anything. The message stream defaults to
# `outbound` (the default transactional stream).
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound

# Mailgun API key and sending domain for `pnpm send:test`. A sandbox domain
# (`sandbox….mailgun.org`) only delivers to authorized recipients. MAILGUN_REGION
# is `us` (default) or `eu`, matching the region the domain was created in.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_REGION=us

# Transport for `pnpm send:test`: `smtp`, `resend`, `postmark` or `mailgun`.
# Unset, it is `resend` when RESEND_API_KEY is set and `smtp` otherwise.
# MAIL_TRANSPORT=smtp

# Sender and recipients. MAIL_TO takes a comma-separated list.
# MAIL_FROM is required for every transport except a local SMTP server without
# SMTP_USER: real providers only accept a From address on the authenticated
# account or its domain.
# MAIL_FROM=MyApp <no-reply@example.com>
# MAIL_TO=Lizzie <lizzie@example.com>
