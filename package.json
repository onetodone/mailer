{
  "name": "@onetodone/mailer",
  "version": "0.3.7",
  "description": "Type-safe transactional emails for Node.js: built-in templates, branding, i18n and pluggable transports, fully customizable.",
  "keywords": [
    "email",
    "mailer",
    "transactional-email",
    "email-templates",
    "email-verification",
    "password-reset",
    "smtp",
    "nodemailer",
    "resend",
    "i18n",
    "typescript",
    "otp",
    "magic-link",
    "html-email",
    "email-template",
    "better-auth",
    "authjs",
    "nextjs",
    "nestjs"
  ],
  "homepage": "https://onetodone.github.io/mailer/",
  "bugs": {
    "url": "https://github.com/onetodone/mailer/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onetodone/mailer.git"
  },
  "author": {
    "name": "Anton Holubeu",
    "email": "anton@holu.dev",
    "url": "https://github.com/aholu"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./smtp": {
      "import": {
        "types": "./dist/smtp/index.d.mts",
        "default": "./dist/smtp/index.mjs"
      },
      "require": {
        "types": "./dist/smtp/index.d.cts",
        "default": "./dist/smtp/index.cjs"
      }
    },
    "./resend": {
      "import": {
        "types": "./dist/resend/index.d.mts",
        "default": "./dist/resend/index.mjs"
      },
      "require": {
        "types": "./dist/resend/index.d.cts",
        "default": "./dist/resend/index.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs/index.d.mts",
        "default": "./dist/nestjs/index.mjs"
      },
      "require": {
        "types": "./dist/nestjs/index.d.cts",
        "default": "./dist/nestjs/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "smtp": [
        "./dist/smtp/index.d.cts"
      ],
      "resend": [
        "./dist/resend/index.d.cts"
      ],
      "nestjs": [
        "./dist/nestjs/index.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "changeset": "changeset",
    "check:package": "pnpm build && publint && attw --pack . && node scripts/check-declarations.ts",
    "check:docs": "pnpm build && node scripts/check-docs.ts",
    "preview": "pnpm build && node --env-file-if-exists=.env scripts/preview.ts",
    "send:test": "pnpm build && node --env-file-if-exists=.env scripts/send-test.ts",
    "screenshots": "pnpm build && node scripts/screenshots.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "nodemailer": ">=6"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/testing": "^12.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.12",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.1.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsdown": "^0.23.1",
    "typescript": "~6",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
